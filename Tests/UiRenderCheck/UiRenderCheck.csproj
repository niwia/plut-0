<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>uitest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Classic.Avalonia.Theme" Version="12.0.1-beta1" />
  </ItemGroup>

  <!-- Reference the built app rather than recompiling its sources: the Avalonia
       XAML source generator produces InitializeComponent, and re-running it
       outside the real project means re-creating its MSBuild wiring. -->
  <ItemGroup>
    <Reference Include="Pluto">
      <HintPath>/home/aiwin/Documents/pluto/bin/Debug/net10.0/Pluto.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>