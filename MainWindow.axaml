<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Pluto.Models"
        mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="580"
        x:Class="Pluto.MainWindow"
        Title="PLUT-0"
        Width="980" Height="580"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#000000"
        FontFamily="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif">

    <Window.Resources>
        <SolidColorBrush x:Key="NativeGameColor" Color="#FFFFFF" />
        <SolidColorBrush x:Key="NativeGameHoverColor" Color="#CCCCCC" />
        <SolidColorBrush x:Key="NativeGameUnselectedColor" Color="#555555" />
        <SolidColorBrush x:Key="AccelaGameColor" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AccelaGameHoverColor" Color="#CCCCCC" />
        <SolidColorBrush x:Key="AccelaGameUnselectedColor" Color="#555555" />
    </Window.Resources>

    <Window.Styles>
        <!-- Pure clean ListBox with hidden scrollbars -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0, 8" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBoxItem:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Niagara Waterfall Typography: Clean, NO BOLD anywhere -->
        <Style Selector="ListBoxItem TextBlock.gameTitle">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource NativeGameUnselectedColor}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="FontSize" Duration="0:0:0.18" Easing="CubicEaseOut" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ListBoxItem:pointerover TextBlock.gameTitle">
            <Setter Property="Foreground" Value="{DynamicResource NativeGameHoverColor}" />
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style Selector="ListBoxItem:selected TextBlock.gameTitle">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource NativeGameColor}" />
        </Style>

        <!-- ACCELA Installed Games: Refined theme color -->
        <Style Selector="ListBoxItem TextBlock.accela">
            <Setter Property="Foreground" Value="{DynamicResource AccelaGameUnselectedColor}" />
        </Style>

        <Style Selector="ListBoxItem:pointerover TextBlock.accela">
            <Setter Property="Foreground" Value="{DynamicResource AccelaGameHoverColor}" />
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style Selector="ListBoxItem:selected TextBlock.accela">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource AccelaGameColor}" />
        </Style>

        <!-- Games list scrolling bounding box: Allows waterfall list to flow with seamless bottom fade -->
        <Style Selector="ListBox#GamesListBox">
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="ClipToBounds" Value="False" />
        </Style>
        <Style Selector="ListBox#SearchResultsListBox">
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="ClipToBounds" Value="False" />
        </Style>

        <!-- Minimal Search Box: Low opacity, no bold, no emojis -->
        <Style Selector="TextBox.minimalSearch">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#999999" />
            <Setter Property="CaretBrush" Value="#888888" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="TextBox.minimalSearch:focus">
            <Setter Property="Opacity" Value="0.9" />
        </Style>

        <Style Selector="TextBox.minimalSearch:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.minimalSearch:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Minimal Plain Text Buttons: No backgrounds, no borders, no emojis -->
        <Style Selector="Button.minimalTextBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
                    <DoubleTransition Property="FontSize" Duration="0:0:0.18" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.minimalTextBtn:pointerover">
            <Setter Property="Foreground" Value="#CCCCCC" />
        </Style>
        <Style Selector="Button.minimalTextBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.minimalTextBtn:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Search Results Item Styles: Clean, fast, no bold, subtle dark translucency -->
        <Style Selector="ListBox#SearchResultsListBox ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0, 2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="ListBox#SearchResultsListBox ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#0DFFFFFF" />
        </Style>

        <Style Selector="ListBox#SearchResultsListBox ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#1AFFFFFF" />
        </Style>

        <!-- Subtle Metadata Tag Pills (no bold, no emojis) -->
        <Style Selector="Border.tagPill">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="7, 3" />
            <Setter Property="Margin" Value="0, 0, 6, 0" />
        </Style>
        <Style Selector="TextBlock.tagPillText">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#777777" />
        </Style>
        <Style Selector="Button.settingsTabBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0, 4" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.settingsTabBtn:pointerover">
            <Setter Property="Foreground" Value="#CCCCCC" />
        </Style>
        <Style Selector="Button.settingsTabBtn.active">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Focused action button: no borders, just a brighter text + subtle scale -->
        <Style Selector="Button.actionBtnFocused">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.actionBtnFocused TextBlock">
            <Setter Property="FontSize" Value="18" />
        </Style>
        <Style Selector="Button.actionBtnFocused /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Controller Prompt Labels: Plain Text (A) select, (B) back, etc. Zero box/pill styling -->
        <Style Selector="TextBlock.ctrlPrompt">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#777777" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.ctrlPromptKey">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.btnBadge">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.btnBadgeText">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.hintLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#777777" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <!-- Root Container -->
    <Grid>
        <!-- Dynamic Rotating Background — only shown on main list, hidden on detail/settings -->
        <Image x:Name="MainBackdropImage"
               Stretch="UniformToFill"
               Opacity="0"
               IsHitTestVisible="False"
               IsVisible="False">
            <Image.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.6" Easing="CubicEaseOut" />
                </Transitions>
            </Image.Transitions>
            <!-- Left-to-right fade matching the detail backdrop gradient -->
            <Image.OpacityMask>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#FFFFFFFF" Offset="0.0" />
                    <GradientStop Color="#BBFFFFFF" Offset="0.4" />
                    <GradientStop Color="#44FFFFFF" Offset="0.75" />
                    <GradientStop Color="#00000000" Offset="1.0" />
                </LinearGradientBrush>
            </Image.OpacityMask>
        </Image>

        <!-- Dedicated dark vignette specifically behind the top-right status & Pluto watermark -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Width="480"
                Height="320"
                IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="100%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#F0000000" Offset="0.0" />
                    <GradientStop Color="#90000000" Offset="0.5" />
                    <GradientStop Color="#00000000" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Top-Right Integrated Status sewn into the main window -->
        <StackPanel HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,36,64,0"
                    Spacing="4">
            <TextBlock Text="plut-0"
                       FontSize="22"
                       FontWeight="Normal"
                       Foreground="#FFFFFF"
                       Opacity="0.95"
                       HorizontalAlignment="Right" />
            <TextBlock x:Name="PlutoVersionText"
                       Text="0.0.8-2509+09+26"
                       FontSize="13"
                       FontWeight="Normal"
                       Foreground="#666666"
                       HorizontalAlignment="Right" />

            <!-- Visor Status Lines Right Aligned: Same weight and size as game names (20px) with increased spacing -->
            <StackPanel Orientation="Vertical" Spacing="10" Margin="0,14,0,0" HorizontalAlignment="Right">
                <!-- API: xx/xx -->
                <TextBlock x:Name="VisorHubcapText"
                           Text="API: --/--"
                           FontSize="20"
                           FontWeight="Normal"
                           Foreground="#777777"
                           HorizontalAlignment="Right" />

                <!-- SLS: active -->
                <TextBlock x:Name="VisorSlsText"
                           Text="SLS: checking..."
                           FontSize="20"
                           FontWeight="Normal"
                           Foreground="#777777"
                           HorizontalAlignment="Right" />

                <!-- Steam: online -->
                <TextBlock x:Name="VisorSteamText"
                           Text="Steam: offline"
                           FontSize="20"
                           FontWeight="Normal"
                           Foreground="#777777"
                           HorizontalAlignment="Right" />

                <!-- health: status (clickable to health settings) -->
                <TextBlock x:Name="VisorHealthText"
                           Text="health: checking..."
                           FontSize="20"
                           FontWeight="Normal"
                           Foreground="#34D399"
                           Cursor="Hand"
                           PointerPressed="OnVisorHealthClicked"
                           HorizontalAlignment="Right" />
            </StackPanel>
        </StackPanel>

        <!-- 1. MAIN LIST VIEW -->
        <Grid x:Name="MainListPanel"
              RowDefinitions="Auto,*,Auto"
              Margin="64,48,64,24"
              IsVisible="True">
            <Grid.Transitions>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut" />
                </Transitions>
            </Grid.Transitions>
            
            <!-- Top: Minimal Search Box with (Y) Controller Prompt -->
            <StackPanel Grid.Row="0" Margin="0,0,0,0" HorizontalAlignment="Left" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Classes="ctrlPromptKey" Text="(Y)" Cursor="Hand" PointerPressed="OnSearchBadgeClicked" VerticalAlignment="Center" />
                    <TextBox x:Name="SearchBox"
                             Classes="minimalSearch"
                             PlaceholderText="search games..."
                             TextChanged="OnSearchTextChanged"
                             KeyDown="OnSearchBoxKeyDown"
                             GotFocus="OnSearchBoxGotFocus" />
                </StackPanel>
                <TextBlock x:Name="SearchStatusText"
                           FontSize="13"
                           FontWeight="Normal"
                           Foreground="#666666"
                           IsVisible="False" />
            </StackPanel>

            <!-- Bottom: Waterfall List of Games / Search Results (seamless gradual bottom blur/fade) -->
            <Grid Grid.Row="1" Margin="0, 42, 0, 0">
                <Grid.OpacityMask>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#FFFFFFFF" Offset="0.0" />
                        <GradientStop Color="#FFFFFFFF" Offset="0.55" />
                        <GradientStop Color="#88FFFFFF" Offset="0.80" />
                        <GradientStop Color="#00000000" Offset="1.0" />
                    </LinearGradientBrush>
                </Grid.OpacityMask>
                <!-- 1A: Normal Installed Games Waterfall (glides up when accessed) -->
                <ListBox x:Name="GamesListBox"
                         SelectionMode="Single"
                         DoubleTapped="OnGameDoubleTapped"
                         SelectionChanged="OnGameSelectionChanged"
                         KeyDown="OnGameListKeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:PluginGame">
                            <TextBlock Classes="gameTitle"
                                       Classes.accela="{Binding IsAccela}"
                                       Text="{Binding Name}"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 1B: Online & Cached Search Results with in-memory Capsule Thumbnails -->
                <ListBox x:Name="SearchResultsListBox"
                         SelectionMode="Single"
                         DoubleTapped="OnSearchResultDoubleTapped"
                         SelectionChanged="OnSearchResultSelectionChanged"
                         KeyDown="OnSearchResultsKeyDown"
                         IsVisible="False">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:SearchResultItem">
                            <Border Background="Transparent"
                                    CornerRadius="6"
                                    Padding="8, 6"
                                    Margin="0, 2">
                                 <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                     <!-- In-memory game thumbnail (clean capsule) -->
                                     <Border Grid.Column="0"
                                             Width="110"
                                             Height="50"
                                             CornerRadius="4"
                                             ClipToBounds="True"
                                             Background="#0FFFFFFF">
                                         <Image Source="{Binding Thumbnail}"
                                                Stretch="UniformToFill"
                                                IsVisible="{Binding HasThumbnail}" />
                                     </Border>

                                     <!-- Game Details -->
                                     <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                         <TextBlock Text="{Binding Name}"
                                                    FontSize="17"
                                                    FontWeight="Normal"
                                                    Foreground="{Binding TitleColorHex}" />
                                         <StackPanel Orientation="Horizontal" Spacing="8">
                                             <TextBlock Text="{Binding AppId, StringFormat='App ID: {0}'}"
                                                        FontSize="12"
                                                        Foreground="#555555" />
                                             <TextBlock Text="{Binding StatusText, StringFormat='•  {0}'}"
                                                        FontSize="12"
                                                        Foreground="{Binding StatusColorHex}" />
                                         </StackPanel>
                                     </StackPanel>
                                 </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Minimal Empty State -->
                <TextBlock x:Name="EmptyStateText"
                           Text="no games found"
                           FontSize="18"
                           FontWeight="Normal"
                           Foreground="#333333"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Margin="0,12,0,0"
                           IsVisible="False" />
            </Grid>

            <!-- Row 2: Controller Hints on Left & Settings on Right -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,16,0,0" VerticalAlignment="Bottom">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                    <TextBlock Classes="ctrlPrompt" Text="(A) select" />
                    <TextBlock Classes="ctrlPrompt" Text="(X) options" />
                    <TextBlock Classes="ctrlPrompt" Text="(Y) search" />
                </StackPanel>

                <!-- Settings Button -->
                <Button x:Name="SettingsBtn"
                        Grid.Column="1"
                        Classes="minimalTextBtn"
                        Content="settings"
                        Focusable="False"
                        Click="OnOpenSettingsClicked" />
            </Grid>
        </Grid>

        <!-- 2. GAME DETAIL PAGE VIEW (Seamless window-integrated view with blurred/dimmed backdrop) -->
        <Grid x:Name="GameDetailPanel"
              Margin="0"
              IsVisible="False">

            <!-- Seamless Backdrop Dimmer -->
            <Border Background="#E6080A0E"
                    Cursor="Hand"
                    PointerPressed="OnBackBadgeClicked" />

            <!-- Integrated Content Grid (Direct window alignment matching main view, no card borders) -->
            <Grid Margin="64,48,64,24">
                    <!-- Right-aligned Game Backdrop Artwork with Opacity Gradient Mask -->
                    <Image x:Name="DetailGameBackdrop"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Stretch"
                           Stretch="UniformToFill"
                           Width="760"
                           Opacity="0.55"
                           IsHitTestVisible="False">
                        <Image.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.35" Easing="CubicEaseOut" />
                            </Transitions>
                        </Image.Transitions>
                        <Image.OpacityMask>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                <GradientStop Color="#00000000" Offset="0.0" />
                                <GradientStop Color="#22000000" Offset="0.18" />
                                <GradientStop Color="#88000000" Offset="0.45" />
                                <GradientStop Color="#FFFFFFFF" Offset="0.85" />
                            </LinearGradientBrush>
                        </Image.OpacityMask>
                    </Image>

                    <!-- Foreground Content: Top Info & Bottom Actions / Gallery -->
                    <Grid RowDefinitions="Auto,*,Auto,Auto"
                          Margin="36,26,36,20">
                        
                        <!-- Row 0: Back Button with (B) Controller Prompt -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Classes="ctrlPromptKey" Text="(B)" Cursor="Hand" PointerPressed="OnBackBadgeClicked" VerticalAlignment="Center" />
                            <Button Classes="minimalTextBtn"
                                    Content="back"
                                    Focusable="False"
                                    Click="OnBackToMainClicked" />
                        </StackPanel>

                        <!-- Row 1: Header (Left Margin) & Indented Details (Right Offset) -->
                        <StackPanel Grid.Row="1" Spacing="4" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <!-- SteamGridDB Transparent Logo (falls back cleanly to Title text) -->
                            <Image x:Name="DetailGameLogo"
                                   MaxHeight="70"
                                   MaxWidth="320"
                                   HorizontalAlignment="Left"
                                   Stretch="Uniform"
                                   Margin="0,0,0,6"
                                   IsVisible="False" />

                            <TextBlock x:Name="DetailGameTitle"
                                       Text="Game Title"
                                       FontSize="32"
                                       FontWeight="Normal"
                                       Foreground="#FFFFFF" />

                            <TextBlock x:Name="DetailGameSubtitle"
                                       Text="3473250  •  native"
                                       FontSize="14"
                                       FontWeight="Normal"
                                       Foreground="#777777" />

                            <!-- Indented details section (offset slightly to the right) -->
                            <StackPanel Margin="32, 10, 0, 0" Spacing="9">
                                <TextBlock x:Name="DetailGameCredits"
                                           Text=""
                                           FontSize="13"
                                           FontWeight="Normal"
                                           Foreground="#999999"
                                           IsVisible="False" />

                                <!-- Simple Rating Row matching the rest of the text -->
                                <StackPanel x:Name="DetailRatingRow"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center"
                                            IsVisible="False">
                                    <TextBlock Text="★" FontSize="14" Foreground="#FBBF24" VerticalAlignment="Center" />
                                    <TextBlock x:Name="DetailRatingScoreText"
                                               Text="4.2 / 5"
                                               FontSize="13"
                                               FontWeight="Normal"
                                               Foreground="#FFFFFF"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="DetailRatingSubText"
                                               Text="2.4k reviews • exceptional"
                                               FontSize="13"
                                               FontWeight="Normal"
                                               Foreground="#888888"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Other metrics: Playtime & Metacritic -->
                                <TextBlock x:Name="DetailRawgMeta"
                                           Text=""
                                           FontSize="13"
                                           FontWeight="Normal"
                                           Foreground="#60A5FA"
                                           IsVisible="False" />

                                <!-- Top 3 Tags Row with SteamDB Icons -->
                                <WrapPanel x:Name="DetailTagsPanel"
                                           Orientation="Horizontal"
                                           Margin="0,2,0,0"
                                           IsVisible="False" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Row 2: Bottom Section (Left Actions Indented, Right Screenshot Gallery) -->
                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" VerticalAlignment="Bottom">
                            <!-- Bottom-Left: All Actions & Toggles (Indented to match details) -->
                            <StackPanel Grid.Column="0" Margin="32,0,0,0" Spacing="14" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                <!-- Primary Mode Switch Action: "add to plugin" / "move to assella" -->
                                <StackPanel Spacing="4">
                                    <Button x:Name="DetailSwitchModeBtn"
                                            Classes="minimalTextBtn"
                                            Content="add to plugin"
                                            FontSize="17"
                                            Foreground="#4ADE80"
                                            Click="OnToggleModeClicked" />
                                    <TextBlock x:Name="DetailActionStatus"
                                               FontSize="12"
                                               Foreground="#777777"
                                               IsVisible="False" />
                                </StackPanel>

                                <!-- Online Toggles Row: SLSonline, Netsock Proxy & EOS Proxy -->
                                <StackPanel x:Name="DetailOnlineTogglesRow" Orientation="Horizontal" Spacing="22">
                                    <Button x:Name="DetailSlsOnlineBtn"
                                            Classes="minimalTextBtn"
                                            Content="enable slsonline"
                                            FontSize="14"
                                            Click="OnToggleSlsOnlineClicked" />

                                    <Button x:Name="DetailNetsockBtn"
                                            Classes="minimalTextBtn"
                                            Content="enable netsock proxy"
                                            FontSize="14"
                                            IsVisible="False"
                                            Click="OnToggleNetsockClicked" />

                                    <Button x:Name="DetailEosProxyBtn"
                                            Classes="minimalTextBtn"
                                            Content="enable eos proxy"
                                            FontSize="14"
                                            IsVisible="False"
                                            Click="OnToggleEosProxyClicked" />
                                </StackPanel>

                                <!-- Steamless Action -->
                                <StackPanel x:Name="DetailSteamlessRow" Spacing="4">
                                    <Button x:Name="DetailSteamlessBtn"
                                            Classes="minimalTextBtn"
                                            Content="apply steamless"
                                            FontSize="14"
                                            Click="OnApplySteamlessClicked" />
                                    <TextBlock x:Name="DetailSteamlessStatus"
                                               FontSize="12"
                                               Foreground="#777777"
                                               IsVisible="False" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Bottom-Right: Circling Screenshot Gallery Controls (Timer-driven) -->
                            <StackPanel x:Name="DetailGalleryControls"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="12"
                                        VerticalAlignment="Bottom"
                                        HorizontalAlignment="Right"
                                        IsVisible="False">
                                <Button x:Name="DetailPrevScreenBtn"
                                        Classes="minimalTextBtn"
                                        Content="&lt;"
                                        FontSize="18"
                                        Foreground="#888888"
                                        Focusable="False"
                                        Click="OnPrevScreenshotClicked" />
                                <TextBlock x:Name="DetailGalleryIndexText"
                                           Text="1 / 6"
                                           FontSize="13"
                                           Foreground="#666666"
                                           VerticalAlignment="Center" />
                                <Button x:Name="DetailNextScreenBtn"
                                        Classes="minimalTextBtn"
                                        Content="&gt;"
                                        FontSize="18"
                                        Foreground="#888888"
                                        Focusable="False"
                                        Click="OnNextScreenshotClicked" />
                            </StackPanel>
                        </Grid>

                        <!-- Row 3: Controller Hints Footer Bar -->
                        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="32,18,0,0" VerticalAlignment="Bottom">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                                <TextBlock Classes="ctrlPrompt" Text="(↑↓) navigate" />
                                <TextBlock Classes="ctrlPrompt" Text="(A) select" />
                                <TextBlock Classes="ctrlPrompt" Text="(B) back" />
                                <TextBlock Classes="ctrlPrompt" Text="(X) options" />
                            </StackPanel>

                            <Button Classes="minimalTextBtn"
                                    Grid.Column="1"
                                    Content="settings"
                                    Focusable="False"
                                    Click="OnOpenSettingsClicked" />
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

        <!-- 3. SETTINGS PAGE VIEW WITH SUBMENUS (Theme, API, SLS Config, Visuals) -->
        <Grid x:Name="SettingsPanel"
              RowDefinitions="Auto,Auto,Auto,*,Auto"
              Margin="64,48,64,28"
              IsVisible="False">
            
            <!-- Row 0: Back Button with (B) Controller Prompt -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,0,20">
                <TextBlock Classes="ctrlPromptKey" Text="(B)" Cursor="Hand" PointerPressed="OnBackBadgeClicked" VerticalAlignment="Center" />
                <Button Classes="minimalTextBtn"
                        Content="back"
                        Focusable="False"
                        Click="OnBackToMainClicked" />
            </StackPanel>

            <!-- Row 1: Settings Title -->
            <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,24">
                <TextBlock Text="settings"
                           FontSize="30"
                           FontWeight="Normal"
                           Foreground="#FFFFFF" />
                <TextBlock Text="system, themes &amp; configuration"
                           FontSize="14"
                           FontWeight="Normal"
                           Foreground="#555555" />
            </StackPanel>

            <!-- Row 2: Submenu Tab Navigation Bar with [←→] switch tab hint -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="28" Margin="0,0,0,28" VerticalAlignment="Center">
                <Button x:Name="SettingsTabThemeBtn"
                        Classes="settingsTabBtn active"
                        Content="theme"
                        Click="OnSettingsTabThemeClicked" />
                <Button x:Name="SettingsTabApiBtn"
                        Classes="settingsTabBtn"
                        Content="api"
                        Click="OnSettingsTabApiClicked" />
                <Button x:Name="SettingsTabSlsBtn"
                        Classes="settingsTabBtn"
                        Content="sls config"
                        Click="OnSettingsTabSlsClicked" />
                <Button x:Name="SettingsTabVisualsBtn"
                        Classes="settingsTabBtn"
                        Content="visuals &amp; gallery"
                        Click="OnSettingsTabVisualsClicked" />
                <Button x:Name="SettingsTabHealthBtn"
                        Classes="settingsTabBtn"
                        Content="health &amp; sanitation"
                        Click="OnSettingsTabHealthClicked" />
                <TextBlock Classes="ctrlPrompt" Text="(←→) switch tab" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Row 3: Submenu Content Panels -->
            <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                <Grid>
                    <!-- 3A: THEME SUBMENU -->
                    <StackPanel x:Name="SettingsThemePanel" Spacing="24" IsVisible="True">
                        <StackPanel Spacing="4">
                            <TextBlock Text="native games color" FontSize="13" Foreground="#666666" />
                            <Button x:Name="ToggleNativeThemeBtn"
                                    Classes="minimalTextBtn"
                                    Content="classic white"
                                    FontSize="16"
                                    Foreground="#FFFFFF"
                                    Click="OnToggleNativeThemeClicked" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="assella games color" FontSize="13" Foreground="#666666" />
                            <Button x:Name="ToggleAccelaThemeBtn"
                                    Classes="minimalTextBtn"
                                    Content="slate blue"
                                    FontSize="16"
                                    Foreground="#60A5FA"
                                    Click="OnToggleAccelaThemeClicked" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="reset list on search access" FontSize="13" Foreground="#666666" />
                            <Button x:Name="ToggleSearchResetBtn"
                                    Classes="minimalTextBtn"
                                    Content="enabled (reset position)"
                                    FontSize="16"
                                    Foreground="#4ADE80"
                                    Click="OnToggleSearchResetClicked" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 3B: API SUBMENU -->
                    <StackPanel x:Name="SettingsApiPanel" Spacing="24" IsVisible="False">
                        <StackPanel Spacing="4">
                            <TextBlock Text="steamgriddb (official logos &amp; heroes)" FontSize="13" Foreground="#666666" />
                            <Button x:Name="ToggleSgdbApiBtn"
                                    Classes="minimalTextBtn"
                                    Content="api active"
                                    FontSize="16"
                                    Foreground="#4ADE80"
                                    Click="OnToggleSgdbApiClicked" />
                            <TextBlock Text="saved in ~/.config/pluto/steamgriddb_api.txt" FontSize="11" Foreground="#444444" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="rawg (metadata, tags &amp; gallery)" FontSize="13" Foreground="#666666" />
                            <Button x:Name="ToggleRawgBtn"
                                    Classes="minimalTextBtn"
                                    Content="api active"
                                    FontSize="16"
                                    Foreground="#4ADE80"
                                    Click="OnToggleRawgClicked" />
                            <TextBlock Text="saved in ~/.config/pluto/rawg_api.txt" FontSize="11" Foreground="#444444" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="hubcap / morrenus (keys &amp; manifests)" FontSize="13" Foreground="#666666" />
                            <Button x:Name="ToggleHubcapApiBtn"
                                    Classes="minimalTextBtn"
                                    Content="api configured"
                                    FontSize="16"
                                    Foreground="#4ADE80"
                                    Click="OnToggleHubcapApiClicked" />
                            <TextBlock Text="saved in ACCELA.conf (morrenus_api_key)" FontSize="11" Foreground="#444444" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 3C: SLS CONFIG SUBMENU -->
                    <StackPanel x:Name="SettingsSlsPanel" Spacing="24" IsVisible="False">
                        <StackPanel Spacing="4">
                            <TextBlock Text="at0-m plugin engine" FontSize="13" Foreground="#666666" />
                            <Button x:Name="ToggleVaporBtn"
                                    Classes="minimalTextBtn"
                                    Content="enabled"
                                    FontSize="16"
                                    Foreground="#38BDF8"
                                    Click="OnToggleVaporClicked" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="download provider" FontSize="13" Foreground="#666666" />
                            <Button x:Name="ToggleDownloadActionBtn"
                                    Classes="minimalTextBtn"
                                    Content="native steam"
                                    FontSize="16"
                                    Foreground="#38BDF8"
                                    Click="OnToggleDownloadActionClicked" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="steam updates" FontSize="13" Foreground="#666666" />
                            <Button x:Name="ToggleUpdatesBtn"
                                    Classes="minimalTextBtn"
                                    Content="normal (updates allowed)"
                                    FontSize="16"
                                    Foreground="#38BDF8"
                                    Click="OnToggleUpdatesClicked" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="slssteam synchronization" FontSize="13" Foreground="#666666" />
                            <Button Classes="minimalTextBtn"
                                    Content="sync all games into config.yaml"
                                    FontSize="16"
                                    Foreground="#818CF8"
                                    Click="OnSyncAllClicked" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="slssteam api pipe" FontSize="13" Foreground="#666666" />
                            <Button Classes="minimalTextBtn"
                                    Content="reload slssteam plugins (reloadlua)"
                                    FontSize="16"
                                    Foreground="#818CF8"
                                    Click="OnReloadSlsClicked" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 3D: VISUALS & GALLERY SUBMENU -->
                    <StackPanel x:Name="SettingsVisualsPanel" Spacing="24" IsVisible="False">
                        <!-- Main Page Dynamic Rotating Backdrop -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="main page dynamic backdrop" FontSize="13" Foreground="#666666" />
                            <Button x:Name="ToggleMainBackdropBtn"
                                    Classes="minimalTextBtn"
                                    Content="enabled"
                                    FontSize="16"
                                    Foreground="#38BDF8"
                                    Click="OnToggleMainBackdropClicked" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="main backdrop rotation speed" FontSize="13" Foreground="#666666" />
                            <Button x:Name="ToggleMainBackdropIntervalBtn"
                                    Classes="minimalTextBtn"
                                    Content="15 seconds"
                                    FontSize="16"
                                    Foreground="#38BDF8"
                                    Click="OnToggleMainBackdropIntervalClicked" />
                        </StackPanel>

                        <!-- Search Thumbnails Toggle -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="search results thumbnails" FontSize="13" Foreground="#666666" />
                            <Button x:Name="ToggleSearchThumbnailsBtn"
                                    Classes="minimalTextBtn"
                                    Content="enabled"
                                    FontSize="16"
                                    Foreground="#38BDF8"
                                    Click="OnToggleSearchThumbnailsClicked" />
                        </StackPanel>

                        <!-- Screenshot Gallery Auto-Rotate Settings -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="detail gallery auto-rotation" FontSize="13" Foreground="#666666" />
                            <Button x:Name="ToggleAutoRotateBtn"
                                    Classes="minimalTextBtn"
                                    Content="enabled"
                                    FontSize="16"
                                    Foreground="#38BDF8"
                                    Click="OnToggleAutoRotateClicked" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="detail gallery rotation speed" FontSize="13" Foreground="#666666" />
                            <Button x:Name="ToggleAutoRotateIntervalBtn"
                                    Classes="minimalTextBtn"
                                    Content="6 seconds"
                                    FontSize="16"
                                    Foreground="#38BDF8"
                                    Click="OnToggleAutoRotateIntervalClicked" />
                        </StackPanel>

                        <!-- System Information -->
                        <StackPanel Spacing="4" Margin="0, 12, 0, 0">
                            <TextBlock Text="library summary" FontSize="13" Foreground="#666666" />
                            <TextBlock x:Name="SettingsGameCountsText" Text="loading..." FontSize="14" Foreground="#AAAAAA" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="controller" FontSize="13" Foreground="#666666" />
                            <TextBlock x:Name="SettingsControllerText" Text="no controller detected" FontSize="14" Foreground="#AAAAAA" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="pluto log" FontSize="13" Foreground="#666666" />
                            <TextBlock x:Name="SettingsLogPathText" Text="~/.local/share/pluto/pluto.log" FontSize="14" Foreground="#AAAAAA" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 3E: HEALTH & SANITATION SUBMENU -->
                    <StackPanel x:Name="SettingsHealthPanel" Spacing="24" IsVisible="False">
                        <!-- System Status Overview -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="system diagnostic summary" FontSize="13" Foreground="#666666" />
                            <TextBlock x:Name="HealthSummaryStatusText"
                                       Text="Checking system status..."
                                       FontSize="15"
                                       Foreground="#4ADE80" />
                            <TextBlock x:Name="HealthIssuesListText"
                                       Text="All critical services are running optimally."
                                       FontSize="12"
                                       Foreground="#888888"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Hubcap Quota Details -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="hubcap / morrenus quota usage" FontSize="13" Foreground="#666666" />
                            <TextBlock x:Name="HealthHubcapQuotaText"
                                       Text="Querying Hubcap API..."
                                       FontSize="14"
                                       Foreground="#CCCCCC" />
                            <TextBlock Text="API Key source: ~/.config/Tachibana Labs/ACCELA.conf" FontSize="11" Foreground="#444444" />
                        </StackPanel>

                        <!-- ASSfixer: SLSsteam Config Diagnostic & Repair -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="assfixer (slssteam config.yaml diagnostics)" FontSize="13" Foreground="#666666" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <Button x:Name="AssfixerCheckBtn"
                                        Classes="minimalTextBtn"
                                        Content="validate config"
                                        FontSize="15"
                                        Foreground="#38BDF8"
                                        Click="OnAssfixerCheckClicked" />
                                <Button x:Name="AssfixerRepairBtn"
                                        Classes="minimalTextBtn"
                                        Content="repair &amp; sync syntax"
                                        FontSize="15"
                                        Foreground="#4ADE80"
                                        Click="OnAssfixerRepairClicked" />
                                <Button x:Name="AssfixerRestoreBtn"
                                        Classes="minimalTextBtn"
                                        Content="restore backup"
                                        FontSize="15"
                                        Foreground="#F87171"
                                        Click="OnAssfixerRestoreClicked" />
                            </StackPanel>
                            <TextBlock x:Name="AssfixerStatusText"
                                       Text=""
                                       FontSize="12"
                                       Foreground="#777777"
                                       TextWrapping="Wrap"
                                       IsVisible="False" />
                        </StackPanel>

                        <!-- Cache & Config Sanitation -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="sanitation &amp; maintenance" FontSize="13" Foreground="#666666" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <Button x:Name="SanitationClearThumbnailsBtn"
                                        Classes="minimalTextBtn"
                                        Content="clear thumbnail cache"
                                        FontSize="15"
                                        Foreground="#E2E8F0"
                                        Click="OnClearThumbnailCacheClicked" />
                                <Button x:Name="SanitationResyncSlsBtn"
                                        Classes="minimalTextBtn"
                                        Content="trigger sls reload (touch)"
                                        FontSize="15"
                                        Foreground="#E2E8F0"
                                        Click="OnResyncSlsClicked" />
                                <Button x:Name="HealthRefreshBtn"
                                        Classes="minimalTextBtn"
                                        Content="refresh health"
                                        FontSize="15"
                                        Foreground="#38BDF8"
                                        Click="OnRefreshHealthClicked" />
                            </StackPanel>
                            <TextBlock x:Name="SanitationStatusText"
                                       Text=""
                                       FontSize="12"
                                       Foreground="#777777"
                                       TextWrapping="Wrap"
                                       IsVisible="False" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Row 4: Controller Hints Footer Bar -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="18" Margin="0,16,0,0" VerticalAlignment="Center">
                <TextBlock Classes="ctrlPrompt" Text="(←→) tabs" />
                <TextBlock Classes="ctrlPrompt" Text="(↑↓) navigate" />
                <TextBlock Classes="ctrlPrompt" Text="(A) toggle" />
                <TextBlock Classes="ctrlPrompt" Text="(B) back" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
