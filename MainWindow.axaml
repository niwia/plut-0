<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Pluto.Models"
        mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="580"
        x:Class="Pluto.MainWindow"
        Title="PLUT-0"
        Width="980" Height="580"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#000000"
        FontFamily="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif">

    <Window.Styles>
        <!-- Pure clean ListBox with hidden scrollbars -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0, 8" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBoxItem:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Niagara Waterfall Typography -->
        <Style Selector="ListBoxItem TextBlock.gameTitle">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#444444" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="FontSize" Duration="0:0:0.18" Easing="CubicEaseOut" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ListBoxItem:pointerover TextBlock.gameTitle">
            <Setter Property="Foreground" Value="#888888" />
            <Setter Property="FontSize" Value="24" />
        </Style>

        <Style Selector="ListBoxItem:selected TextBlock.gameTitle">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Pure Minimal Search Box -->
        <Style Selector="TextBox.minimalSearch">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style Selector="TextBox.minimalSearch:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="TextBox.minimalSearch:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Styles>

    <!-- Main Container: Pure black, left-aligned Niagara layout -->
    <Grid RowDefinitions="Auto,*" Margin="64,48,64,36">
        <!-- Top: Search Games Button / Input -->
        <Grid Grid.Row="0" Margin="0,0,0,32" HorizontalAlignment="Left">
            <TextBox x:Name="SearchBox"
                     Classes="minimalSearch"
                     PlaceholderText="Search games..."
                     TextChanged="OnSearchTextChanged"
                     KeyDown="OnSearchBoxKeyDown" />
        </Grid>

        <!-- Bottom: Waterfall List of Games -->
        <Grid Grid.Row="1">
            <ListBox x:Name="GamesListBox"
                     SelectionMode="Single"
                     DoubleTapped="OnGameDoubleTapped"
                     SelectionChanged="OnGameSelectionChanged"
                     KeyDown="OnGameListKeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:PluginGame">
                        <TextBlock Classes="gameTitle"
                                   Text="{Binding Name}"
                                   VerticalAlignment="Center" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Minimal Empty State -->
            <TextBlock x:Name="EmptyStateText"
                       Text="No games found"
                       FontSize="18"
                       Foreground="#333333"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Margin="0,12,0,0"
                       IsVisible="False" />
        </Grid>
    </Grid>
</Window>
