<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Pluto.Models"
        xmlns:controls="clr-namespace:Pluto.Controls"
        xmlns:installation="clr-namespace:Pluto.Engine.Installation"
        mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="580"
        x:Class="Pluto.MainWindow"
        Title="PLUT-0"
        Width="980" Height="580"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#000000"
        FontFamily="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif">

    <Window.Resources>
        <SolidColorBrush x:Key="NativeGameColor" Color="#FFFFFF" />
        <SolidColorBrush x:Key="NativeGameHoverColor" Color="#CCCCCC" />
        <SolidColorBrush x:Key="NativeGameUnselectedColor" Color="#555555" />
        <SolidColorBrush x:Key="AccelaGameColor" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AccelaGameHoverColor" Color="#CCCCCC" />
        <SolidColorBrush x:Key="AccelaGameUnselectedColor" Color="#555555" />
    </Window.Resources>

    <Window.Styles>
        <!-- Pure clean ListBox with hidden scrollbars -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
        </Style>

        <!-- Fixed-height rows.
             Selection used to be signalled by growing the type from 20px to 32px.
             With no fixed height that resized the row and pushed everything below
             it down the screen, so scrolling made the list jump. Rows are now a
             constant height and focus is carried by a selection bar instead. -->
        <Style Selector="ListBoxItem">
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Unfocused: a faint wash, enough to separate rows over a photo backdrop -->
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#14FFFFFF" />
        </Style>

        <!-- Focused: a solid bar. Reads at TV distance and never reflows. -->
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NativeGameColor}" />
        </Style>

        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NativeGameHoverColor}" />
        </Style>

        <!-- Library rows: uniform type, emphasis by colour rather than size -->
        <Style Selector="ListBoxItem TextBlock.gameTitle">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource NativeGameUnselectedColor}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ListBoxItem:pointerover TextBlock.gameTitle">
            <Setter Property="Foreground" Value="{DynamicResource NativeGameHoverColor}" />
        </Style>

        <Style Selector="ListBoxItem:selected TextBlock.gameTitle">
            <Setter Property="Foreground" Value="#0A0A0C" />
        </Style>

        <!-- ACCELA-managed rows use the accent palette instead -->
        <Style Selector="ListBoxItem TextBlock.accela">
            <Setter Property="Foreground" Value="{DynamicResource AccelaGameUnselectedColor}" />
        </Style>

        <Style Selector="ListBoxItem:pointerover TextBlock.accela">
            <Setter Property="Foreground" Value="{DynamicResource AccelaGameHoverColor}" />
        </Style>

        <Style Selector="ListBoxItem:selected TextBlock.accela">
            <Setter Property="Foreground" Value="#0A0A0C" />
        </Style>

        <!-- Games list scrolling bounding box: Allows waterfall list to flow with seamless bottom fade -->
        <Style Selector="ListBox#GamesListBox">
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="ClipToBounds" Value="False" />
        </Style>
        <Style Selector="ListBox#SearchResultsListBox">
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="ClipToBounds" Value="False" />
        </Style>

        <!-- Minimal Search Box: Low opacity, no bold, no emojis -->
        <Style Selector="TextBox.minimalSearch">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#999999" />
            <Setter Property="CaretBrush" Value="#888888" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="TextBox.minimalSearch:focus">
            <Setter Property="Opacity" Value="0.9" />
        </Style>

        <Style Selector="TextBox.minimalSearch:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.minimalSearch:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Minimal Plain Text Buttons: No backgrounds, no borders, no emojis -->
        <Style Selector="Button.minimalTextBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
                    <DoubleTransition Property="FontSize" Duration="0:0:0.18" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.minimalTextBtn:pointerover">
            <Setter Property="Foreground" Value="#CCCCCC" />
        </Style>
        <Style Selector="Button.minimalTextBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.minimalTextBtn:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Search Results Item Styles: Clean, fast, no bold, subtle dark translucency -->
        <Style Selector="ListBox#SearchResultsListBox ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0, 2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="ListBox#SearchResultsListBox ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#0DFFFFFF" />
        </Style>

        <Style Selector="ListBox#SearchResultsListBox ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#1AFFFFFF" />
        </Style>

        <!-- Subtle Metadata Tag Pills (no bold, no emojis) -->
        <Style Selector="Border.tagPill">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="7, 3" />
            <Setter Property="Margin" Value="0, 0, 6, 0" />
        </Style>
        <Style Selector="TextBlock.tagPillText">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#777777" />
        </Style>

        <!-- Focused action button: no borders, just a brighter text + subtle scale -->
        <Style Selector="Button.actionBtnFocused">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.actionBtnFocused TextBlock">
            <Setter Property="FontSize" Value="18" />
        </Style>
        <Style Selector="Button.actionBtnFocused /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Controller Prompt Labels: Plain Text (A) select, (B) back, etc. Zero box/pill styling -->
        <Style Selector="TextBlock.ctrlPrompt">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#777777" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.ctrlPromptKey">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.btnBadge">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.btnBadgeText">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.hintLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#777777" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Home view: the search field is the hero -->
        <Style Selector="TextBox.heroSearch">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderBrush" Value="#26FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#F0F0F0" />
            <Setter Property="CaretBrush" Value="#B0B0B0" />
            <Setter Property="SelectionBrush" Value="#4A5B8C" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="TextBox.heroSearch:focus">
            <Setter Property="BorderBrush" Value="#5A6E96" />
            <Setter Property="Background" Value="#1AFFFFFF" />
        </Style>
        <Style Selector="TextBox.heroSearch /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="#6A6A6A" />
        </Style>

        <!-- Quiet rail labels: identity, counts, hints -->
        <Style Selector="TextBlock.railLabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#7A7A7A" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Filmstrip cards -->
        <Style Selector="controls|FilmstripCard">
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <Style Selector="controls|FilmstripCard:selected">
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="BorderBrush" Value="#66FFFFFF" />
            <Setter Property="RenderTransform" Value="scale(1.04)" />
        </Style>

        <Style Selector="TextBlock.rowTitle">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="#C8C8C8" />
        </Style>

        <!-- Settings: category rail on the left, rows on the right -->
        <Style Selector="Button.settingsRailBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#707070" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style Selector="Button.settingsRailBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#0FFFFFFF" />
        </Style>
        <Style Selector="Button.settingsRailBtn.active">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#14FFFFFF" />
        </Style>

        <Style Selector="Border.settingRow">
            <Setter Property="Background" Value="#08FFFFFF" />
            <Setter Property="BorderBrush" Value="#12FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style Selector="TextBlock.settingGroup">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#5E5E5E" />
            <Setter Property="Margin" Value="2,14,0,8" />
        </Style>

        <Style Selector="TextBlock.settingLabel">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#B4B4B4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.settingValueText">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="16,0,0,0" />
        </Style>

        <Style Selector="TextBlock.settingHint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#555555" />
        </Style>

        <!-- The value is the only interactive part of a row, so it reads as the affordance -->
        <Style Selector="Button.settingValue">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.settingValue:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#14FFFFFF" />
        </Style>
        <Style Selector="Button.settingValue:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <Style Selector="Button.settingAction">
            <Setter Property="Background" Value="#0FFFFFFF" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.settingAction:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1AFFFFFF" />
        </Style>
        <Style Selector="ListBoxItem:selected TextBlock.rowTitle">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#1E5B8C" />
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#12FFFFFF" />
        </Style>

        <!-- Sort / filter chips: quiet until hovered or focused -->
        <Style Selector="Button.chip">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#999999" />
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="BorderBrush" Value="#22FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.chip:pointerover /template/ ContentPresenter">
            <Setter Property="TextBlock.Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.chip:pointerover">
            <Setter Property="Background" Value="#33FFFFFF" />
        </Style>
        <Style Selector="Button.chip:focus">
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="BorderBrush" Value="#66FFFFFF" />
        </Style>

        <!-- Per-row sync state -->
        <Style Selector="TextBlock.syncBadge">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <!-- Root Container -->
    <Grid>
    <!-- Quick actions panel, opened with (X) -->
        <Border x:Name="QuickActionsPanel"
                    IsVisible="False"
                    Margin="64,48,64,24"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="#F2121216"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="18,14"
                    Width="280">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="QuickActionsTitle"
                               FontSize="13"
                               Foreground="#CCCCCC"
                               Text="actions" />

                    <Button x:Name="QuickActionSyncBtn"   Classes="chip" Content="sync to sls"      Click="OnQuickActionSyncClicked" />
                    <Button x:Name="QuickActionOpenBtn"   Classes="chip" Content="open install dir" Click="OnQuickActionOpenClicked" />
                    <Button x:Name="QuickActionCopyBtn"   Classes="chip" Content="copy appid"       Click="OnQuickActionCopyClicked" />
                    <Button x:Name="QuickActionDetailBtn" Classes="chip" Content="show depot keys"  Click="OnQuickActionDepotsClicked" />
                    <Button x:Name="QuickActionCloseBtn"  Classes="chip" Content="close"            Click="OnQuickActionCloseClicked" />

                    <TextBlock x:Name="QuickActionsStatus"
                               FontSize="11"
                               Foreground="#7A7A7A"
                               TextWrapping="Wrap"
                               MaxWidth="240"
                               IsVisible="False" />
                </StackPanel>
            </Border>
        <!-- Dynamic Rotating Background — only shown on main list, hidden on detail/settings -->
        <Image x:Name="MainBackdropImage"
               Stretch="UniformToFill"
               Opacity="0"
               IsHitTestVisible="False"
               IsVisible="False">
            <Image.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.6" Easing="CubicEaseOut" />
                </Transitions>
            </Image.Transitions>
            <!-- Left-to-right fade matching the detail backdrop gradient -->
            <Image.OpacityMask>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#FFFFFFFF" Offset="0.0" />
                    <GradientStop Color="#BBFFFFFF" Offset="0.4" />
                    <GradientStop Color="#44FFFFFF" Offset="0.75" />
                    <GradientStop Color="#00000000" Offset="1.0" />
                </LinearGradientBrush>
            </Image.OpacityMask>
        </Image>

        <!-- Dedicated dark vignette specifically behind the top-right status & Pluto watermark -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Width="480"
                Height="320"
                IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="100%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#F0000000" Offset="0.0" />
                    <GradientStop Color="#90000000" Offset="0.5" />
                    <GradientStop Color="#00000000" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Top-Right Integrated Status sewn into the main window -->
        <StackPanel HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,36,64,0"
                    Spacing="4">
            <TextBlock Text="plut-0"
                       FontSize="22"
                       FontWeight="Normal"
                       Foreground="#FFFFFF"
                       Opacity="0.95"
                       HorizontalAlignment="Right" />
            <TextBlock x:Name="PlutoVersionText"
                       Text="0.0.8-2509+09+26"
                       FontSize="13"
                       FontWeight="Normal"
                       Foreground="#666666"
                       HorizontalAlignment="Right" />

            <!-- Visor Status Lines Right Aligned: Same weight and size as game names (20px) with increased spacing -->
            <StackPanel Orientation="Vertical" Spacing="10" Margin="0,14,0,0" HorizontalAlignment="Right">
                <!-- API: xx/xx -->
                <TextBlock x:Name="VisorHubcapText"
                           Text="API: --/--"
                           FontSize="20"
                           FontWeight="Normal"
                           Foreground="#777777"
                           HorizontalAlignment="Right" />

                <!-- SLS: active -->
                <TextBlock x:Name="VisorSlsText"
                           Text="SLS: checking..."
                           FontSize="20"
                           FontWeight="Normal"
                           Foreground="#777777"
                           HorizontalAlignment="Right" />

                <!-- Steam: online -->
                <TextBlock x:Name="VisorSteamText"
                           Text="Steam: offline"
                           FontSize="20"
                           FontWeight="Normal"
                           Foreground="#777777"
                           HorizontalAlignment="Right" />

                <!-- health: status (clickable to health settings) -->
                <TextBlock x:Name="VisorHealthText"
                           Text="health: checking..."
                           FontSize="20"
                           FontWeight="Normal"
                           Foreground="#34D399"
                           Cursor="Hand"
                           PointerPressed="OnVisorHealthClicked"
                           HorizontalAlignment="Right" />
            </StackPanel>
        </StackPanel>

        <!-- 1. MAIN LIST VIEW -->
        <!-- 1. HOME VIEW: centred search, filmstrip below, everything else on the rail -->
        <Grid x:Name="MainListPanel"
              RowDefinitions="Auto,*,Auto"
              Margin="0,0,0,0"
              IsVisible="True">

            <!-- Top rail: identity and library counts, deliberately quiet -->
            <Grid Grid.Row="0" Margin="40,26,40,0" ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0"
                           Classes="railLabel"
                           VerticalAlignment="Center"
                           Text="PLUTO" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock x:Name="RailUpdateCount" Classes="railLabel" VerticalAlignment="Center" />
                    <TextBlock x:Name="RailGameCount" Classes="railLabel" VerticalAlignment="Center" />
                    <Button x:Name="SettingsBtn"
                            Classes="minimalTextBtn"
                            Content="settings"
                            Focusable="False"
                            Click="OnOpenSettingsClicked" />
                </StackPanel>
            </Grid>

            <!-- Centre: the search field is the hero, as on an agent home screen -->
            <Grid Grid.Row="1">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Width="620"
                            Spacing="18">

                    <TextBox x:Name="SearchBox"
                             Classes="heroSearch"
                             PlaceholderText="search games or appids"
                             TextChanged="OnSearchTextChanged"
                             KeyDown="OnSearchBoxKeyDown"
                             GotFocus="OnSearchBoxGotFocus" />

                    <!-- Filters sit under the field, centred, and stay out of the way -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Center">
                        <Button x:Name="SortChipBtn" Classes="chip" Content="sort: name"  Click="OnSortChipClicked" />
                        <Button x:Name="ModeChipBtn" Classes="chip" Content="all"          Click="OnModeChipClicked" />
                        <Button x:Name="UpdatesChipBtn" Classes="chip" Content="updates"  Click="OnUpdatesChipClicked" />
                    </StackPanel>

                    <TextBlock x:Name="SearchStatusText"
                               Classes="railLabel"
                               HorizontalAlignment="Center"
                               IsVisible="False" />

                    <TextBlock x:Name="EmptyStateText"
                               Text="no games found"
                               FontSize="15"
                               Foreground="#5A5A5A"
                               HorizontalAlignment="Center"
                               IsVisible="False" />
                </StackPanel>

                <!-- Overlay shown above the field once a query is running or resolved -->
                <Grid x:Name="SearchOverlay" IsVisible="False" Background="#CC0A0A0C">
                    <ListBox x:Name="SearchResultsListBox"
                             MaxWidth="760"
                             MaxHeight="420"
                             Margin="40"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             SelectionMode="Single"
                             DoubleTapped="OnSearchResultDoubleTapped"
                             SelectionChanged="OnSearchResultSelectionChanged"
                             KeyDown="OnSearchResultsKeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:SearchResultItem">
                                <Grid Height="46" ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Width="64" Height="30" CornerRadius="3"
                                            Margin="0,0,12,0" VerticalAlignment="Center"
                                            Background="#14FFFFFF">
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Classes="rowTitle"
                                               Text="{Binding Name}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Classes="railLabel"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding InstallMode}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>

            <!-- Bottom: filmstrip of the library, updates first -->
            <Grid Grid.Row="2" Margin="0,0,0,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Classes="railLabel"
                           Margin="40,0,0,8"
                           Text="library" />

                <controls:Filmstrip x:Name="Filmstrip"
                                    Grid.Row="1"
                                    Margin="40,0,0,0"
                                    ItemActivated="OnFilmstripItemActivated">
                    <controls:Filmstrip.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </controls:Filmstrip.ItemsPanel>
                    <controls:Filmstrip.ItemTemplate>
                        <DataTemplate DataType="controls:FilmstripEntry">
                            <controls:FilmstripCard>
                                <Grid RowDefinitions="116,Auto">
                                    <!-- Artwork, or a neutral placeholder when not loaded -->
                                    <Grid Grid.Row="0">
                                        <Border Background="#0FFFFFFF" />
                                        <Image Source="{Binding Artwork}" Stretch="UniformToFill" />
                                    </Grid>

                                    <Grid Grid.Row="1" Margin="10,7,10,8" ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="12"
                                                       Foreground="#D8D8D8"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}"
                                                       FontSize="10"
                                                       Foreground="#6E6E6E"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Update dot: present only when a newer build exists -->
                                        <Border Grid.Column="1"
                                                Width="9" Height="9"
                                                CornerRadius="5"
                                                Margin="6,3,0,0"
                                                VerticalAlignment="Top"
                                                Background="#5EEAD4"
                                                IsVisible="{Binding HasUpdate}" />
                                    </Grid>
                                </Grid>
                            </controls:FilmstripCard>
                        </DataTemplate>
                    </controls:Filmstrip.ItemTemplate>
                </controls:Filmstrip>
            </Grid>
        </Grid>

        <!-- 2. GAME DETAIL PAGE VIEW (Seamless window-integrated view with subtle backdrop) -->
<!-- 2. GAME DETAIL PAGE: full-bleed rotating art, one column of facts, actions on the right -->
        <Grid x:Name="GameDetailPanel"
              Margin="0"
              IsVisible="False">

            <!-- Rotating artwork: screenshots, hero art or store backdrop, whichever resolved last.
                 Full-bleed rather than the old right-hand panel, so the image is the page. -->
            <Image x:Name="DetailGameBackdrop"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   Stretch="UniformToFill"
                   Opacity="0.55"
                   IsHitTestVisible="False">
                <Image.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.35" Easing="CubicEaseOut" />
                    </Transitions>
                </Image.Transitions>
                <!-- Sinks to black at the bottom and left so text stays readable over any artwork -->
                <Image.OpacityMask>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="25%,100%">
                        <GradientStop Color="#FF444444" Offset="0.0" />
                        <GradientStop Color="#FF101010" Offset="0.45" />
                        <GradientStop Color="#FF000000" Offset="0.8" />
                    </LinearGradientBrush>
                </Image.OpacityMask>
            </Image>

            <!-- Click-through backdrop used to dismiss the page. -->
            <Border Background="Transparent"
                    Cursor="Hand"
                    PointerPressed="OnBackBadgeClicked" />

            <Grid Margin="56,38,56,26" RowDefinitions="Auto,*,Auto,Auto">

                <!-- Row 0: back -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
                    <TextBlock Classes="ctrlPromptKey" Text="(B)" Cursor="Hand" PointerPressed="OnBackBadgeClicked" VerticalAlignment="Center" />
                    <Button Classes="minimalTextBtn"
                            Content="back"
                            Focusable="False"
                            Click="OnBackToMainClicked" />
                </StackPanel>

                <!-- Row 1: the facts, anchored low-left -->
                <StackPanel Grid.Row="1" Spacing="7" HorizontalAlignment="Left" VerticalAlignment="Bottom" MaxWidth="620">
                    <Image x:Name="DetailGameLogo"
                           MaxHeight="52"
                           MaxWidth="280"
                           HorizontalAlignment="Left"
                           Stretch="Uniform"
                           Margin="0,0,0,6"
                           IsVisible="False" />

                    <TextBlock x:Name="DetailGameTitle"
                               Text="Game Title"
                               FontSize="34"
                               FontWeight="Normal"
                               Foreground="#FFFFFF" />

                    <TextBlock x:Name="DetailGameSubtitle"
                               Text="3473250  |  native"
                               FontSize="13"
                               FontWeight="Normal"
                               Foreground="#8A8A8A" />

                    <TextBlock x:Name="DetailGameCredits"
                               Text=""
                               FontSize="13"
                               FontWeight="Normal"
                               Foreground="#9A9A9A"
                               TextWrapping="Wrap"
                               IsVisible="False" />

                    <StackPanel x:Name="DetailRatingRow"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center"
                                IsVisible="False">
                        <TextBlock Text="rating"
                                   FontSize="12"
                                   Foreground="#FBBF24"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="DetailRatingScoreText"
                                   Text="4.2 / 5"
                                   FontSize="12"
                                   FontWeight="Normal"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="DetailRatingSubText"
                                   Text="2.4k reviews - exceptional"
                                   FontSize="12"
                                   FontWeight="Normal"
                                   Foreground="#8A8A8A"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock x:Name="DetailRawgMeta"
                               Text=""
                               FontSize="12"
                               FontWeight="Normal"
                               Foreground="#8A8A8A"
                               IsVisible="False" />

                    <WrapPanel x:Name="DetailTagsPanel"
                               Orientation="Horizontal"
                               Margin="0,4,0,0"
                               IsVisible="False" />
                </StackPanel>

                <!-- Row 2: status and actions, right-aligned so the art stays clear -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,26,0,0">
                    <TextBlock Grid.Column="0" Classes="ctrlPrompt" VerticalAlignment="Bottom" Text="(LB) (RB) artwork" />

                    <StackPanel Grid.Column="1" Width="330" Spacing="10" HorizontalAlignment="Right">

                        <!-- Update banner: only present when a newer build exists -->
                        <Border x:Name="DetailUpdateBanner"
                                Padding="14,11"
                                CornerRadius="8"
                                Background="#141F1A"
                                BorderBrush="#2E4F42"
                                BorderThickness="1"
                                IsVisible="False">
                            <StackPanel Spacing="4">
                                <TextBlock Text="update available"
                                           FontSize="12"
                                           Foreground="#5EEAD4" />
                                <TextBlock x:Name="DetailUpdateText"
                                           FontSize="11"
                                           Foreground="#7FA898" />
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="6" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Right">
                                <Button x:Name="DetailSwitchModeBtn"
                                        Classes="minimalTextBtn"
                                        Content="add to plugin"
                                        FontSize="14"
                                        Foreground="#4ADE80"
                                        Click="OnToggleModeClicked" />
                                <Button x:Name="DetailDownloadBtn"
                                        Classes="minimalTextBtn"
                                        Content="download game"
                                        FontSize="14"
                                        Foreground="#38BDF8"
                                        IsVisible="False"
                                        Click="OnDownloadGameClicked" />
                            </StackPanel>
                            <TextBlock x:Name="DetailActionStatus"
                                       FontSize="11"
                                       Foreground="#777777"
                                       HorizontalAlignment="Right"
                                       TextAlignment="Right"
                                       IsVisible="False" />
                        </StackPanel>

                        <!-- Online toggles: SLS, netsock proxy, EOS proxy -->
                        <StackPanel x:Name="DetailOnlineTogglesRow"
                                    Orientation="Horizontal"
                                    Spacing="18"
                                    HorizontalAlignment="Right">
                            <Button x:Name="DetailSlsOnlineBtn"
                                    Classes="minimalTextBtn"
                                    Content="enable slsonline"
                                    FontSize="13"
                                    Click="OnToggleSlsOnlineClicked" />

                            <Button x:Name="DetailNetsockBtn"
                                    Classes="minimalTextBtn"
                                    Content="enable netsock proxy"
                                    FontSize="13"
                                    IsVisible="False"
                                    Click="OnToggleNetsockClicked" />

                            <Button x:Name="DetailEosProxyBtn"
                                    Classes="minimalTextBtn"
                                    Content="enable eos proxy"
                                    FontSize="13"
                                    IsVisible="False"
                                    Click="OnToggleEosProxyClicked" />
                        </StackPanel>

                        <StackPanel x:Name="DetailSteamlessRow" Spacing="3" HorizontalAlignment="Right">
                            <Button x:Name="DetailSteamlessBtn"
                                    Classes="minimalTextBtn"
                                    Content="apply steamless"
                                    FontSize="13"
                                    Click="OnApplySteamlessClicked" />
                            <TextBlock x:Name="DetailSteamlessStatus"
                                       FontSize="11"
                                       Foreground="#777777"
                                       HorizontalAlignment="Right"
                                       TextAlignment="Right"
                                       IsVisible="False" />
                        </StackPanel>

                        <!-- Depot picker, revealed by the download button -->
                        <Border x:Name="PreDownloadPanel"
                                Padding="14,12"
                                Background="#0C0F14"
                                BorderBrush="#1F293D"
                                BorderThickness="1"
                                CornerRadius="8"
                                IsVisible="False">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto" Margin="0,0,0,8">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="storage" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                                        <Button x:Name="PreDownloadStorageBtn"
                                                Classes="minimalTextBtn"
                                                Content="Internal Storage"
                                                FontSize="12"
                                                Foreground="#F1F5F9"
                                                Click="OnPreDownloadStorageCycleClicked" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <TextBlock Text="branch" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                                        <Button x:Name="PreDownloadBranchBtn"
                                                Classes="minimalTextBtn"
                                                Content="public"
                                                FontSize="12"
                                                Foreground="#38BDF8"
                                                Click="OnPreDownloadBranchCycleClicked" />
                                    </StackPanel>
                                </Grid>

                                <ScrollViewer Grid.Row="1" MaxHeight="170" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="PreDownloadDepotsItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="installation:PreDownloadDepotItem">
                                                <Border Background="#12161F" CornerRadius="4" Padding="8,5" Margin="0,2">
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding DepotId, StringFormat='depot {0}'}" FontSize="10" Foreground="#64748B" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding SizeString}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,10,0,0" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" x:Name="PreDownloadTotalSizeText" Text="" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                        <Button x:Name="PreDownloadCancelBtn"
                                                Classes="minimalTextBtn"
                                                Content="cancel"
                                                FontSize="12"
                                                Foreground="#64748B"
                                                Click="OnPreDownloadCancelClicked" />
                                        <Button x:Name="PreDownloadConfirmBtn"
                                                Background="#0284C7"
                                                Foreground="#FFFFFF"
                                                CornerRadius="4"
                                                Padding="12,5"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Content="start download"
                                                Click="OnPreDownloadConfirmClicked" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Row 3: artwork paging on the right, control hints on the left -->
                <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,18,0,0">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                        <TextBlock Classes="ctrlPrompt" Text="(dpad) navigate" />
                        <TextBlock Classes="ctrlPrompt" Text="(A) select" />
                        <TextBlock Classes="ctrlPrompt" Text="(B) back" />
                        <TextBlock Classes="ctrlPrompt" Text="(X) options" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <StackPanel x:Name="DetailGalleryControls"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center"
                                    IsVisible="False">
                            <Button x:Name="DetailPrevScreenBtn"
                                    Classes="minimalTextBtn"
                                    Content="&lt;"
                                    FontSize="16"
                                    Foreground="#888888"
                                    Focusable="False"
                                    Click="OnPrevScreenshotClicked" />
                            <TextBlock x:Name="DetailGalleryIndexText"
                                       Text="1 / 6"
                                       FontSize="12"
                                       Foreground="#666666"
                                       VerticalAlignment="Center" />
                            <Button x:Name="DetailNextScreenBtn"
                                    Classes="minimalTextBtn"
                                    Content="&gt;"
                                    FontSize="16"
                                    Foreground="#888888"
                                    Focusable="False"
                                    Click="OnNextScreenshotClicked" />
                        </StackPanel>

                        <Button Classes="minimalTextBtn"
                                Content="settings"
                                Focusable="False"
                                Click="OnOpenSettingsClicked" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- 3. SETTINGS PAGE VIEW WITH SUBMENUS (Theme, API, SLS Config, Visuals) -->
<!-- 3. SETTINGS: categories on the left rail, the selected category on the right -->
        <Grid x:Name="SettingsPanel"
              RowDefinitions="Auto,*,Auto"
              Margin="48,36,48,24"
              IsVisible="False">

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,22">
                <TextBlock Classes="ctrlPromptKey" Text="(B)" Cursor="Hand" PointerPressed="OnBackBadgeClicked" VerticalAlignment="Center" />
                <Button Classes="minimalTextBtn"
                        Content="back"
                        Focusable="False"
                        Click="OnBackToMainClicked" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnDefinitions="176,*">
                <StackPanel Grid.Column="0" Spacing="2">
                    <Button x:Name="SettingsTabThemeBtn"
                            Classes="settingsRailBtn active"
                            Content="theme"
                            Click="OnSettingsTabThemeClicked" />
                    <Button x:Name="SettingsTabApiBtn"
                            Classes="settingsRailBtn"
                            Content="api"
                            Click="OnSettingsTabApiClicked" />
                    <Button x:Name="SettingsTabSlsBtn"
                            Classes="settingsRailBtn"
                            Content="sls"
                            Click="OnSettingsTabSlsClicked" />
                    <Button x:Name="SettingsTabVisualsBtn"
                            Classes="settingsRailBtn"
                            Content="visuals"
                            Click="OnSettingsTabVisualsClicked" />
                    <Button x:Name="SettingsTabHealthBtn"
                            Classes="settingsRailBtn"
                            Content="health"
                            Click="OnSettingsTabHealthClicked" />
                    <Button x:Name="SettingsTabDdmBtn"
                            Classes="settingsRailBtn"
                            Content="ddm"
                            Click="OnSettingsTabDdmClicked" />
                </StackPanel>

                <ScrollViewer Grid.Column="1"
                              Margin="28,0,0,0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                  <!-- One container: a ScrollViewer accepts a single child, so the
                       six category panels share a grid cell and only the visible
                       one is drawn. -->
                  <Grid>
                    <StackPanel x:Name="SettingsThemePanel" IsVisible="true">
                    <TextBlock Classes="settingGroup" Text="appearance" />
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="settingLabel" Text="control theme" />
                            <Button Grid.Row="0" Grid.Column="1"
                                    Classes="settingValue"
                                    Content="modern"
                                    Foreground="#38BDF8" x:Name="ToggleThemeStyleBtn"
                                    Click="OnToggleThemeStyleClicked" />
                        </Grid>
                    </Border>
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="settingLabel" Text="windows 9x colour scheme" />
                            <Button Grid.Row="0" Grid.Column="1"
                                    Classes="settingValue"
                                    Content="classic only"
                                    Foreground="#38BDF8" x:Name="ToggleClassicSchemeBtn" IsEnabled="False"
                                    Click="OnToggleClassicSchemeClicked" />
                        </Grid>
                    </Border>
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="settingLabel" Text="native games color" />
                            <Button Grid.Row="0" Grid.Column="1"
                                    Classes="settingValue"
                                    Content="classic white"
                                    Foreground="#FFFFFF" x:Name="ToggleNativeThemeBtn"
                                    Click="OnToggleNativeThemeClicked" />
                        </Grid>
                    </Border>
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="settingLabel" Text="assella games color" />
                            <Button Grid.Row="0" Grid.Column="1"
                                    Classes="settingValue"
                                    Content="slate blue"
                                    Foreground="#60A5FA" x:Name="ToggleAccelaThemeBtn"
                                    Click="OnToggleAccelaThemeClicked" />
                        </Grid>
                    </Border>
                    <TextBlock Classes="settingGroup" Text="behaviour" />
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="settingLabel" Text="reset list on search access" />
                            <Button Grid.Row="0" Grid.Column="1"
                                    Classes="settingValue"
                                    Content="enabled (reset position)"
                                    Foreground="#4ADE80" x:Name="ToggleSearchResetBtn"
                                    Click="OnToggleSearchResetClicked" />
                        </Grid>
                    </Border>
                    </StackPanel>
                    <StackPanel x:Name="SettingsApiPanel" IsVisible="false">
                    <TextBlock Classes="settingGroup" Text="service credentials" />
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="settingLabel" Text="steamgriddb  logos and heroes" />
                            <Button Grid.Row="0" Grid.Column="1"
                                    Classes="settingValue"
                                    Content="api active"
                                    Foreground="#4ADE80" x:Name="ToggleSgdbApiBtn"
                                    Click="OnToggleSgdbApiClicked" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Classes="settingHint"
                                   Margin="0,3,0,0"
                                   Text="stored in ~/.config/pluto/steamgriddb_api.txt" />
                        </Grid>
                    </Border>
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="settingLabel" Text="rawg  metadata, tags and gallery" />
                            <Button Grid.Row="0" Grid.Column="1"
                                    Classes="settingValue"
                                    Content="api active"
                                    Foreground="#4ADE80" x:Name="ToggleRawgBtn"
                                    Click="OnToggleRawgClicked" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Classes="settingHint"
                                   Margin="0,3,0,0"
                                   Text="stored in ~/.config/pluto/rawg_api.txt" />
                        </Grid>
                    </Border>
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="settingLabel" Text="hubcap / morrenus  keys and manifests" />
                            <Button Grid.Row="0" Grid.Column="1"
                                    Classes="settingValue"
                                    Content="api configured"
                                    Foreground="#4ADE80" x:Name="ToggleHubcapApiBtn"
                                    Click="OnToggleHubcapApiClicked" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Classes="settingHint"
                                   Margin="0,3,0,0"
                                   Text="stored in ACCELA.conf as morrenus_api_key" />
                        </Grid>
                    </Border>
                    </StackPanel>
                    <StackPanel x:Name="SettingsSlsPanel" IsVisible="false">
                    <TextBlock Classes="settingGroup" Text="at0-m plugin engine" />
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="settingLabel" Text="engine" />
                            <Button Grid.Row="0" Grid.Column="1"
                                    Classes="settingValue"
                                    Content="enabled"
                                    Foreground="#38BDF8" x:Name="ToggleVaporBtn"
                                    Click="OnToggleVaporClicked" />
                        </Grid>
                    </Border>
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="settingLabel" Text="download provider" />
                            <Button Grid.Row="0" Grid.Column="1"
                                    Classes="settingValue"
                                    Content="native steam"
                                    Foreground="#38BDF8" x:Name="ToggleDownloadActionBtn"
                                    Click="OnToggleDownloadActionClicked" />
                        </Grid>
                    </Border>
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="settingLabel" Text="steam updates" />
                            <Button Grid.Row="0" Grid.Column="1"
                                    Classes="settingValue"
                                    Content="normal (updates allowed)"
                                    Foreground="#38BDF8" x:Name="ToggleUpdatesBtn"
                                    Click="OnToggleUpdatesClicked" />
                        </Grid>
                    </Border>
                    <TextBlock Classes="settingGroup" Text="slssteam" />
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="settingLabel" Text="library synchronization" />
                            <Button Grid.Row="0" Grid.Column="1"
                                    x:Name="SettingsSyncAllBtn"
                                    Classes="settingValue"
                                    Content="sync all games into config.yaml"
                                    Foreground="#818CF8"
                                    Click="OnSyncAllClicked" />
                        </Grid>
                    </Border>
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="settingLabel" Text="plugin reload" />
                            <Button Grid.Row="0" Grid.Column="1"
                                    x:Name="SettingsReloadPluginsBtn"
                                    Classes="settingValue"
                                    Content="reload slssteam plugins (reloadlua)"
                                    Foreground="#818CF8"
                                    Click="OnReloadSlsClicked" />
                        </Grid>
                    </Border>
                    </StackPanel>
                    <StackPanel x:Name="SettingsVisualsPanel" IsVisible="false">
                    <TextBlock Classes="settingGroup" Text="backdrop" />
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="settingLabel" Text="home page dynamic backdrop" />
                            <Button Grid.Row="0" Grid.Column="1"
                                    Classes="settingValue"
                                    Content="enabled"
                                    Foreground="#38BDF8" x:Name="ToggleMainBackdropBtn"
                                    Click="OnToggleMainBackdropClicked" />
                        </Grid>
                    </Border>
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="settingLabel" Text="rotation speed" />
                            <Button Grid.Row="0" Grid.Column="1"
                                    Classes="settingValue"
                                    Content="15 seconds"
                                    Foreground="#38BDF8" x:Name="ToggleMainBackdropIntervalBtn"
                                    Click="OnToggleMainBackdropIntervalClicked" />
                        </Grid>
                    </Border>
                    <TextBlock Classes="settingGroup" Text="artwork" />
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="settingLabel" Text="search result thumbnails" />
                            <Button Grid.Row="0" Grid.Column="1"
                                    Classes="settingValue"
                                    Content="enabled"
                                    Foreground="#38BDF8" x:Name="ToggleSearchThumbnailsBtn"
                                    Click="OnToggleSearchThumbnailsClicked" />
                        </Grid>
                    </Border>
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="settingLabel" Text="library artwork (steam cdn)" />
                            <Button Grid.Row="0" Grid.Column="1"
                                    Classes="settingValue"
                                    Content="disabled"
                                    Foreground="#38BDF8" x:Name="ToggleLibraryThumbnailsBtn"
                                    Click="OnToggleLibraryThumbnailsClicked" />
                        </Grid>
                    </Border>
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="settingLabel" Text="detail gallery auto-rotation" />
                            <Button Grid.Row="0" Grid.Column="1"
                                    Classes="settingValue"
                                    Content="enabled"
                                    Foreground="#38BDF8" x:Name="ToggleAutoRotateBtn"
                                    Click="OnToggleAutoRotateClicked" />
                        </Grid>
                    </Border>
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="settingLabel" Text="gallery rotation speed" />
                            <Button Grid.Row="0" Grid.Column="1"
                                    Classes="settingValue"
                                    Content="6 seconds"
                                    Foreground="#38BDF8" x:Name="ToggleAutoRotateIntervalBtn"
                                    Click="OnToggleAutoRotateIntervalClicked" />
                        </Grid>
                    </Border>
                    <TextBlock Classes="settingGroup" Text="about this install" />
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="settingLabel" Text="library summary" />
                            <TextBlock Grid.Column="1"
                                       x:Name="SettingsGameCountsText"
                                       Classes="settingValueText"
                                       Foreground="#AAAAAA"
                                       Text="loading..." />
                        </Grid>
                    </Border>
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="settingLabel" Text="controller" />
                            <TextBlock Grid.Column="1"
                                       x:Name="SettingsControllerText"
                                       Classes="settingValueText"
                                       Foreground="#AAAAAA"
                                       Text="no controller detected" />
                        </Grid>
                    </Border>
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="settingLabel" Text="log" />
                            <TextBlock Grid.Column="1"
                                       x:Name="SettingsLogPathText"
                                       Classes="settingValueText"
                                       Foreground="#E2E8F0"
                                       Text="~/.local/share/pluto/pluto.log" />
                        </Grid>
                    </Border>
                    </StackPanel>
                    <StackPanel x:Name="SettingsHealthPanel" IsVisible="false">
                    <TextBlock Classes="settingGroup" Text="diagnostics" />
                    <Border Classes="settingRow">
                        <StackPanel Spacing="5">
                            <TextBlock x:Name="HealthSummaryStatusText"
                                       Classes="settingValueText"
                                       Foreground="#4ADE80"
                                       Text="Checking system status..." />
                            <TextBlock x:Name="HealthIssuesListText"
                                       Classes="settingHint"
                                       TextWrapping="Wrap"
                                       Text="All critical services are running optimally." />
                        </StackPanel>
                    </Border>
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="settingLabel" Text="hubcap / morrenus quota" />
                            <TextBlock Grid.Column="1"
                                       x:Name="HealthHubcapQuotaText"
                                       Classes="settingValueText"
                                       Foreground="#AAAAAA"
                                       Text="Querying..." />
                        </Grid>
                    </Border>
                    <TextBlock Classes="settingGroup" Text="assfixer  slssteam config.yaml" />
                    <Border Classes="settingRow">
                        <StackPanel Spacing="8">
                            <Button Classes="settingAction" x:Name="AssfixerCheckBtn"
                                    Content="validate config"
                                    Foreground="#38BDF8"
                                    Click="OnAssfixerCheckClicked" />
                            <Button Classes="settingAction" x:Name="AssfixerRepairBtn"
                                    Content="repair and sync syntax"
                                    Foreground="#4ADE80"
                                    Click="OnAssfixerRepairClicked" />
                            <Button Classes="settingAction" x:Name="AssfixerRestoreBtn"
                                    Content="restore backup"
                                    Foreground="#F87171"
                                    Click="OnAssfixerRestoreClicked" />
                        </StackPanel>
                    </Border>
                            <TextBlock x:Name="AssfixerStatusText"
                                       Classes="settingHint"
                                       Margin="0,6,0,0"
                                       IsVisible="False" />
                    <TextBlock Classes="settingGroup" Text="maintenance" />
                    <Border Classes="settingRow">
                        <StackPanel Spacing="8">
                            <Button Classes="settingAction" x:Name="SanitationClearThumbnailsBtn"
                                    Content="clear thumbnail cache"
                                    Foreground="#E2E8F0"
                                    Click="OnClearThumbnailCacheClicked" />
                            <Button Classes="settingAction" x:Name="SanitationResyncSlsBtn"
                                    Content="trigger sls reload (touch)"
                                    Foreground="#E2E8F0"
                                    Click="OnResyncSlsClicked" />
                            <Button Classes="settingAction" x:Name="HealthRefreshBtn"
                                    Content="refresh health"
                                    Foreground="#38BDF8"
                                    Click="OnRefreshHealthClicked" />
                        </StackPanel>
                    </Border>
                            <TextBlock x:Name="SanitationStatusText"
                                       Classes="settingHint"
                                       Margin="0,6,0,0"
                                       IsVisible="False" />
                    </StackPanel>
                    <StackPanel x:Name="SettingsDdmPanel" IsVisible="false">
                    <TextBlock Classes="settingGroup" Text="transfer" />
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="settingLabel" Text="concurrent downloads" />
                            <Button Grid.Row="0" Grid.Column="1"
                                    Classes="settingValue"
                                    Content="4 downloads"
                                    Foreground="#38BDF8" x:Name="ToggleDdmMaxDownloadsBtn"
                                    Click="OnToggleDdmMaxDownloadsClicked" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Classes="settingHint"
                                   Margin="0,3,0,0"
                                   Text="limits simultaneous chunk streams to avoid saturating the network (1 to 30)" />
                        </Grid>
                    </Border>
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="settingLabel" Text="chunk verification" />
                            <Button Grid.Row="0" Grid.Column="1"
                                    Classes="settingValue"
                                    Content="enabled"
                                    Foreground="#4ADE80" x:Name="ToggleDdmValidateBtn"
                                    Click="OnToggleDdmValidateClicked" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Classes="settingHint"
                                   Margin="0,3,0,0"
                                   Text="validates the sha-1 checksum of every chunk against the manifest" />
                        </Grid>
                    </Border>
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="settingLabel" Text="lancache local proxy" />
                            <Button Grid.Row="0" Grid.Column="1"
                                    Classes="settingValue"
                                    Content="enabled"
                                    Foreground="#4ADE80" x:Name="ToggleDdmLanCacheBtn"
                                    Click="OnToggleDdmLanCacheClicked" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Classes="settingHint"
                                   Margin="0,3,0,0"
                                   Text="routes downloads through local network caching servers when present" />
                        </Grid>
                    </Border>
                    <TextBlock Classes="settingGroup" Text="depot selection" />
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="settingLabel" Text="platform preference" />
                            <Button Grid.Row="0" Grid.Column="1"
                                    Classes="settingValue"
                                    Content="native linux first"
                                    Foreground="#FFFFFF" x:Name="ToggleDdmPlatformPrefBtn"
                                    Click="OnToggleDdmPlatformPrefClicked" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Classes="settingHint"
                                   Margin="0,3,0,0"
                                   Text="prefers native linux depots over windows and proton when both exist" />
                        </Grid>
                    </Border>
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="settingLabel" Text="soundtrack and ost depots" />
                            <Button Grid.Row="0" Grid.Column="1"
                                    Classes="settingValue"
                                    Content="hidden by default"
                                    Foreground="#60A5FA" x:Name="ToggleDdmFilterOstBtn"
                                    Click="OnToggleDdmFilterOstClicked" />
                        </Grid>
                    </Border>
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="settingLabel" Text="artbooks, wallpapers and extras" />
                            <Button Grid.Row="0" Grid.Column="1"
                                    Classes="settingValue"
                                    Content="hidden by default"
                                    Foreground="#60A5FA" x:Name="ToggleDdmFilterExtrasBtn"
                                    Click="OnToggleDdmFilterExtrasClicked" />
                        </Grid>
                    </Border>
                    </StackPanel>
                                  </Grid>
                </ScrollViewer>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="18" Margin="0,16,0,0">
                <TextBlock Classes="ctrlPrompt" Text="(dpad) tabs" />
                <TextBlock Classes="ctrlPrompt" Text="(A) toggle" />
                <TextBlock Classes="ctrlPrompt" Text="(B) back" />
            </StackPanel>
        </Grid>

        <!-- PERSISTENT GLOBAL DOWNLOAD PROGRESS BAR -->
        <Border x:Name="GlobalDownloadBar"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Padding="32,6,32,10"
                IsVisible="False"
                ZIndex="999">
            <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                <TextBlock x:Name="GlobalDlGameTitle"
                           Text=""
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="#FFFFFF"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0" />
                <ProgressBar Grid.Column="1"
                             x:Name="GlobalDlProgressBar"
                             Height="2"
                             Minimum="0" Maximum="100" Value="0"
                             Foreground="#FFFFFF"
                             Background="#20FFFFFF"
                             VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
