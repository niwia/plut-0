<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Pluto.Models"
        mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="580"
        x:Class="Pluto.MainWindow"
        Title="PLUT-0"
        Width="980" Height="580"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#000000"
        FontFamily="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif">

    <Window.Styles>
        <!-- Pure clean ListBox with hidden scrollbars -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0, 8" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBoxItem:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Niagara Waterfall Typography: Clean, NO BOLD anywhere -->
        <Style Selector="ListBoxItem TextBlock.gameTitle">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#444444" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="FontSize" Duration="0:0:0.18" Easing="CubicEaseOut" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ListBoxItem:pointerover TextBlock.gameTitle">
            <Setter Property="Foreground" Value="#888888" />
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style Selector="ListBoxItem:selected TextBlock.gameTitle">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- ACCELA Installed Games: Refined Dark Blue with matched visual weight -->
        <Style Selector="ListBoxItem TextBlock.accela">
            <Setter Property="Foreground" Value="#385473" />
        </Style>

        <Style Selector="ListBoxItem:pointerover TextBlock.accela">
            <Setter Property="Foreground" Value="#5278A3" />
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style Selector="ListBoxItem:selected TextBlock.accela">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#60A5FA" />
        </Style>

        <!-- Minimal Search Box: Low opacity, no bold, no emojis -->
        <Style Selector="TextBox.minimalSearch">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#999999" />
            <Setter Property="CaretBrush" Value="#888888" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="TextBox.minimalSearch:focus">
            <Setter Property="Opacity" Value="0.9" />
        </Style>

        <Style Selector="TextBox.minimalSearch:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.minimalSearch:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Minimal Plain Text Buttons: No backgrounds, no borders, no emojis -->
        <Style Selector="Button.minimalTextBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.minimalTextBtn:pointerover">
            <Setter Property="Foreground" Value="#CCCCCC" />
        </Style>
        <Style Selector="Button.minimalTextBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Search Results Card Styles: Clean, no bold, subtle dark translucency -->
        <Style Selector="ListBox#SearchResultsListBox ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0, 2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="ListBox#SearchResultsListBox ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#0DFFFFFF" />
        </Style>

        <Style Selector="ListBox#SearchResultsListBox ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#1AFFFFFF" />
        </Style>
    </Window.Styles>

    <!-- Root Container -->
    <Grid>
        <!-- Non-clickable brand watermark in top-right -->
        <TextBlock Text="plut-0"
                   FontSize="16"
                   FontWeight="Normal"
                   Foreground="#999999"
                   Opacity="0.5"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,48,64,0"
                   IsHitTestVisible="False" />

        <!-- 1. MAIN LIST VIEW -->
        <Grid x:Name="MainListPanel"
              RowDefinitions="Auto,*"
              Margin="64,48,64,36"
              IsVisible="True">
            
            <!-- Top: Minimal Search Box (with generous spacing below) -->
            <StackPanel Grid.Row="0" Margin="0,0,0,32" HorizontalAlignment="Left" Spacing="6">
                <TextBox x:Name="SearchBox"
                         Classes="minimalSearch"
                         PlaceholderText="search games..."
                         TextChanged="OnSearchTextChanged"
                         KeyDown="OnSearchBoxKeyDown" />
                <TextBlock x:Name="SearchStatusText"
                           FontSize="13"
                           FontWeight="Normal"
                           Foreground="#666666"
                           IsVisible="False" />
            </StackPanel>

            <!-- Bottom: Waterfall List of Games / Search Results -->
            <Grid Grid.Row="1">
                <!-- 1A: Normal Installed Games Waterfall -->
                <ListBox x:Name="GamesListBox"
                         SelectionMode="Single"
                         DoubleTapped="OnGameDoubleTapped"
                         SelectionChanged="OnGameSelectionChanged"
                         KeyDown="OnGameListKeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:PluginGame">
                            <TextBlock Classes="gameTitle"
                                       Classes.accela="{Binding IsAccela}"
                                       Text="{Binding Name}"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 1B: Online & Cached Search Results Cards -->
                <ListBox x:Name="SearchResultsListBox"
                         SelectionMode="Single"
                         DoubleTapped="OnSearchResultDoubleTapped"
                         SelectionChanged="OnSearchResultSelectionChanged"
                         KeyDown="OnSearchResultsKeyDown"
                         IsVisible="False">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:SearchResultItem">
                            <Border Background="Transparent"
                                    CornerRadius="8"
                                    Padding="8, 6"
                                    Margin="0, 3">
                                <Grid ColumnDefinitions="Auto,*" Margin="0">
                                    <!-- Left: Thumbnail Artwork -->
                                    <Border Grid.Column="0"
                                            Width="140" Height="65"
                                            CornerRadius="6"
                                            ClipToBounds="True"
                                            Background="#141414">
                                        <Panel>
                                            <TextBlock Text="{Binding AppId}"
                                                       FontSize="11"
                                                       Foreground="#2A2A2A"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <Image Source="{Binding Thumbnail}"
                                                   Stretch="UniformToFill"
                                                   IsVisible="{Binding HasThumbnail}" />
                                        </Panel>
                                    </Border>

                                    <!-- Right: Game Info -->
                                    <StackPanel Grid.Column="1"
                                                Margin="18,0,0,0"
                                                VerticalAlignment="Center"
                                                Spacing="4">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="18"
                                                   FontWeight="Normal"
                                                   Foreground="{Binding TitleColorHex}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding AppId, StringFormat='App ID: {0}'}"
                                                       FontSize="12"
                                                       Foreground="#555555" />
                                            <TextBlock Text="{Binding StatusText, StringFormat='•  {0}'}"
                                                       FontSize="12"
                                                       Foreground="{Binding StatusColorHex}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Minimal Empty State -->
                <TextBlock x:Name="EmptyStateText"
                           Text="no games found"
                           FontSize="18"
                           FontWeight="Normal"
                           Foreground="#333333"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Margin="0,12,0,0"
                           IsVisible="False" />
            </Grid>

            <!-- Settings Button at Bottom Right of Main Page -->
            <Button x:Name="SettingsBtn"
                    Grid.Row="1"
                    Classes="minimalTextBtn"
                    Content="settings"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,0"
                    Click="OnOpenSettingsClicked" />
        </Grid>

        <!-- 2. GAME DETAIL PAGE VIEW -->
        <Grid x:Name="GameDetailPanel"
              Margin="0"
              IsVisible="False">

            <!-- Right-aligned Game Backdrop Artwork with Opacity Gradient Mask -->
            <Image x:Name="DetailGameBackdrop"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Stretch"
                   Stretch="UniformToFill"
                   Width="650"
                   Opacity="0.25"
                   IsHitTestVisible="False">
                <Image.OpacityMask>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="#00000000" Offset="0.0" />
                        <GradientStop Color="#00000000" Offset="0.30" />
                        <GradientStop Color="#FFFFFFFF" Offset="1.0" />
                    </LinearGradientBrush>
                </Image.OpacityMask>
            </Image>

            <!-- Foreground Content (Left Aligned with pure black backing) -->
            <Grid RowDefinitions="Auto,Auto,*"
                  Margin="64,48,64,36">
                
                <!-- Back Button -->
                <Button Grid.Row="0"
                        Classes="minimalTextBtn"
                        Content="back"
                        Margin="0,0,0,24"
                        Click="OnBackToMainClicked" />

                <!-- Game Title & Clean Subtitle (Name, AppID • native/assella) -->
                <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,36">
                    <TextBlock x:Name="DetailGameTitle"
                               Text="Game Title"
                               FontSize="32"
                               FontWeight="Normal"
                               Foreground="#FFFFFF" />
                    <TextBlock x:Name="DetailGameSubtitle"
                               Text="3473250  •  native"
                               FontSize="15"
                               FontWeight="Normal"
                               Foreground="#666666" />
                </StackPanel>

                <!-- Game Page Actions & Toggles -->
                <StackPanel Grid.Row="2" Spacing="24" HorizontalAlignment="Left">
                    <!-- Primary Mode Switch Action: "add to plugin" / "move to assella" -->
                    <StackPanel Spacing="6">
                        <Button x:Name="DetailSwitchModeBtn"
                                Classes="minimalTextBtn"
                                Content="add to plugin"
                                FontSize="17"
                                Foreground="#4ADE80"
                                Click="OnToggleModeClicked" />
                        <TextBlock x:Name="DetailActionStatus"
                                   FontSize="12"
                                   Foreground="#777777"
                                   IsVisible="False" />
                    </StackPanel>

                    <!-- Online Toggles Row: SLSonline & Netsock Proxy -->
                    <StackPanel x:Name="DetailOnlineTogglesRow" Orientation="Horizontal" Spacing="32">
                        <Button x:Name="DetailSlsOnlineBtn"
                                Classes="minimalTextBtn"
                                Content="enable slsonline"
                                FontSize="15"
                                Click="OnToggleSlsOnlineClicked" />

                        <Button x:Name="DetailNetsockBtn"
                                Classes="minimalTextBtn"
                                Content="enable netsock proxy"
                                FontSize="15"
                                IsVisible="False"
                                Click="OnToggleNetsockClicked" />
                    </StackPanel>

                    <!-- Steamless Action -->
                    <StackPanel x:Name="DetailSteamlessRow" Spacing="6" Margin="0,4,0,0">
                        <Button x:Name="DetailSteamlessBtn"
                                Classes="minimalTextBtn"
                                Content="apply steamless"
                                FontSize="15"
                                Click="OnApplySteamlessClicked" />
                        <TextBlock x:Name="DetailSteamlessStatus"
                                   FontSize="12"
                                   Foreground="#777777"
                                   IsVisible="False" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 3. SETTINGS PAGE VIEW (Interactive Toggles & System Control) -->
        <Grid x:Name="SettingsPanel"
              RowDefinitions="Auto,Auto,*"
              Margin="64,48,64,36"
              IsVisible="False">
            
            <!-- Back Button -->
            <Button Grid.Row="0"
                    Classes="minimalTextBtn"
                    Content="back"
                    Margin="0,0,0,24"
                    Click="OnBackToMainClicked" />

            <!-- Settings Title -->
            <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,36">
                <TextBlock Text="settings"
                           FontSize="30"
                           FontWeight="Normal"
                           Foreground="#FFFFFF" />
                <TextBlock Text="system &amp; at0-m configuration"
                           FontSize="14"
                           FontWeight="Normal"
                           Foreground="#555555" />
            </StackPanel>

            <!-- Settings Content: Interactive Toggles & Actions -->
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                <StackPanel Spacing="24">
                    <!-- Toggle: Plugin Engine (enable_vapor) -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="at0-m plugin engine" FontSize="13" Foreground="#666666" />
                        <Button x:Name="ToggleVaporBtn"
                                Classes="minimalTextBtn"
                                Content="enabled"
                                FontSize="16"
                                Foreground="#38BDF8"
                                Click="OnToggleVaporClicked" />
                    </StackPanel>

                    <!-- Toggle: Default Download Action (vapor_default_download_action) -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="download provider" FontSize="13" Foreground="#666666" />
                        <Button x:Name="ToggleDownloadActionBtn"
                                Classes="minimalTextBtn"
                                Content="native steam"
                                FontSize="16"
                                Foreground="#38BDF8"
                                Click="OnToggleDownloadActionClicked" />
                    </StackPanel>

                    <!-- Toggle: Disable Updates (vapor_disable_updates) -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="steam updates" FontSize="13" Foreground="#666666" />
                        <Button x:Name="ToggleUpdatesBtn"
                                Classes="minimalTextBtn"
                                Content="normal (updates allowed)"
                                FontSize="16"
                                Foreground="#38BDF8"
                                Click="OnToggleUpdatesClicked" />
                    </StackPanel>

                    <!-- Action: Sync All Games to SLS -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="slssteam synchronization" FontSize="13" Foreground="#666666" />
                        <Button Classes="minimalTextBtn"
                                Content="sync all games into config.yaml"
                                FontSize="16"
                                Foreground="#818CF8"
                                Click="OnSyncAllClicked" />
                    </StackPanel>

                    <!-- Action: Reload SLSsteam -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="slssteam api pipe" FontSize="13" Foreground="#666666" />
                        <Button Classes="minimalTextBtn"
                                Content="reload slssteam plugins (reloadlua)"
                                FontSize="16"
                                Foreground="#818CF8"
                                Click="OnReloadSlsClicked" />
                    </StackPanel>

                    <!-- Informational: Library Counts & Paths -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="library summary" FontSize="13" Foreground="#666666" />
                        <TextBlock x:Name="SettingsGameCountsText" Text="loading..." FontSize="14" Foreground="#AAAAAA" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="controller" FontSize="13" Foreground="#666666" />
                        <TextBlock x:Name="SettingsControllerText" Text="no controller detected" FontSize="14" Foreground="#AAAAAA" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="pluto log" FontSize="13" Foreground="#666666" />
                        <TextBlock x:Name="SettingsLogPathText" Text="~/.local/share/pluto/pluto.log" FontSize="14" Foreground="#AAAAAA" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
