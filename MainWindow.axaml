<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Pluto.Models"
        mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="580"
        x:Class="Pluto.MainWindow"
        Title="PLUT-0"
        Width="980" Height="580"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#000000"
        FontFamily="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif">

    <Window.Styles>
        <!-- Pure clean ListBox with hidden scrollbars -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0, 8" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBoxItem:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Niagara Waterfall Typography: Clean, NO BOLD anywhere -->
        <Style Selector="ListBoxItem TextBlock.gameTitle">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#444444" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="FontSize" Duration="0:0:0.18" Easing="CubicEaseOut" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ListBoxItem:pointerover TextBlock.gameTitle">
            <Setter Property="Foreground" Value="#888888" />
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style Selector="ListBoxItem:selected TextBlock.gameTitle">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- ACCELA Installed Games: Refined Dark Blue with matched visual weight -->
        <Style Selector="ListBoxItem TextBlock.accela">
            <Setter Property="Foreground" Value="#385473" />
        </Style>

        <Style Selector="ListBoxItem:pointerover TextBlock.accela">
            <Setter Property="Foreground" Value="#5278A3" />
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style Selector="ListBoxItem:selected TextBlock.accela">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#60A5FA" />
        </Style>

        <!-- Minimal Search Box: Low opacity, no bold, no emojis -->
        <Style Selector="TextBox.minimalSearch">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#999999" />
            <Setter Property="CaretBrush" Value="#888888" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="TextBox.minimalSearch:focus">
            <Setter Property="Opacity" Value="0.9" />
        </Style>

        <Style Selector="TextBox.minimalSearch:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.minimalSearch:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Minimal Plain Text Buttons: No backgrounds, no borders, no emojis -->
        <Style Selector="Button.minimalTextBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.minimalTextBtn:pointerover">
            <Setter Property="Foreground" Value="#CCCCCC" />
        </Style>
        <Style Selector="Button.minimalTextBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Styles>

    <!-- Root Container -->
    <Grid>
        <!-- Non-clickable brand watermark in top-right -->
        <TextBlock Text="plut-0"
                   FontSize="16"
                   FontWeight="Normal"
                   Foreground="#999999"
                   Opacity="0.5"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,48,64,0"
                   IsHitTestVisible="False" />

        <!-- 1. MAIN LIST VIEW -->
        <Grid x:Name="MainListPanel"
              RowDefinitions="Auto,*"
              Margin="64,48,64,36"
              IsVisible="True">
            
            <!-- Top: Minimal Search Box (with generous spacing below) -->
            <Grid Grid.Row="0" Margin="0,0,0,60" HorizontalAlignment="Left">
                <TextBox x:Name="SearchBox"
                         Classes="minimalSearch"
                         PlaceholderText="search games..."
                         TextChanged="OnSearchTextChanged"
                         KeyDown="OnSearchBoxKeyDown" />
            </Grid>

            <!-- Bottom: Waterfall List of Games -->
            <Grid Grid.Row="1">
                <ListBox x:Name="GamesListBox"
                         SelectionMode="Single"
                         DoubleTapped="OnGameDoubleTapped"
                         SelectionChanged="OnGameSelectionChanged"
                         KeyDown="OnGameListKeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:PluginGame">
                            <TextBlock Classes="gameTitle"
                                       Classes.accela="{Binding IsAccela}"
                                       Text="{Binding Name}"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Minimal Empty State -->
                <TextBlock x:Name="EmptyStateText"
                           Text="no games found"
                           FontSize="18"
                           FontWeight="Normal"
                           Foreground="#333333"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Margin="0,12,0,0"
                           IsVisible="False" />
            </Grid>

            <!-- Settings Button at Bottom Right of Main Page -->
            <Button x:Name="SettingsBtn"
                    Grid.Row="1"
                    Classes="minimalTextBtn"
                    Content="settings"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,0"
                    Click="OnOpenSettingsClicked" />
        </Grid>

        <!-- 2. GAME DETAIL PAGE VIEW -->
        <Grid x:Name="GameDetailPanel"
              RowDefinitions="Auto,Auto,*"
              Margin="64,48,64,36"
              IsVisible="False">
            
            <!-- Back Button -->
            <Button Grid.Row="0"
                    Classes="minimalTextBtn"
                    Content="back"
                    Margin="0,0,0,24"
                    Click="OnBackToMainClicked" />

            <!-- Game Title & Subtitle -->
            <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,32">
                <TextBlock x:Name="DetailGameTitle"
                           Text="Game Title"
                           FontSize="32"
                           FontWeight="Normal"
                           Foreground="#FFFFFF" />
                <TextBlock x:Name="DetailGameSubtitle"
                           Text="appid: 000000 | mode: at0-m plugin"
                           FontSize="14"
                           FontWeight="Normal"
                           Foreground="#555555" />
            </StackPanel>

            <!-- Game Page Actions -->
            <StackPanel Grid.Row="2" Spacing="16" HorizontalAlignment="Left">
                <Button Classes="minimalTextBtn"
                        Content="launch game"
                        FontSize="18"
                        Foreground="#E0E0E0"
                        Click="OnLaunchDetailGameClicked" />

                <Button x:Name="DetailSyncSlsBtn"
                        Classes="minimalTextBtn"
                        Content="sync to sls config"
                        FontSize="16"
                        Foreground="#888888"
                        Click="OnSyncDetailGameClicked" />

                <Button x:Name="DetailSwitchModeBtn"
                        Classes="minimalTextBtn"
                        Content="convert to at0-m plugin native"
                        FontSize="16"
                        Foreground="#666666"
                        Click="OnToggleModeClicked" />
            </StackPanel>
        </Grid>

        <!-- 3. SETTINGS PAGE VIEW (Interactive Toggles & System Control) -->
        <Grid x:Name="SettingsPanel"
              RowDefinitions="Auto,Auto,*"
              Margin="64,48,64,36"
              IsVisible="False">
            
            <!-- Back Button -->
            <Button Grid.Row="0"
                    Classes="minimalTextBtn"
                    Content="back"
                    Margin="0,0,0,24"
                    Click="OnBackToMainClicked" />

            <!-- Settings Title -->
            <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,36">
                <TextBlock Text="settings"
                           FontSize="30"
                           FontWeight="Normal"
                           Foreground="#FFFFFF" />
                <TextBlock Text="system &amp; at0-m configuration"
                           FontSize="14"
                           FontWeight="Normal"
                           Foreground="#555555" />
            </StackPanel>

            <!-- Settings Content: Interactive Toggles & Actions -->
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                <StackPanel Spacing="24">
                    <!-- Toggle: Plugin Engine (enable_vapor) -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="at0-m plugin engine" FontSize="13" Foreground="#666666" />
                        <Button x:Name="ToggleVaporBtn"
                                Classes="minimalTextBtn"
                                Content="enabled"
                                FontSize="16"
                                Foreground="#38BDF8"
                                Click="OnToggleVaporClicked" />
                    </StackPanel>

                    <!-- Toggle: Default Download Action (vapor_default_download_action) -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="download provider" FontSize="13" Foreground="#666666" />
                        <Button x:Name="ToggleDownloadActionBtn"
                                Classes="minimalTextBtn"
                                Content="native steam"
                                FontSize="16"
                                Foreground="#38BDF8"
                                Click="OnToggleDownloadActionClicked" />
                    </StackPanel>

                    <!-- Toggle: Disable Updates (vapor_disable_updates) -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="steam updates" FontSize="13" Foreground="#666666" />
                        <Button x:Name="ToggleUpdatesBtn"
                                Classes="minimalTextBtn"
                                Content="normal (updates allowed)"
                                FontSize="16"
                                Foreground="#38BDF8"
                                Click="OnToggleUpdatesClicked" />
                    </StackPanel>

                    <!-- Action: Sync All Games to SLS -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="slssteam synchronization" FontSize="13" Foreground="#666666" />
                        <Button Classes="minimalTextBtn"
                                Content="sync all games into config.yaml"
                                FontSize="16"
                                Foreground="#818CF8"
                                Click="OnSyncAllClicked" />
                    </StackPanel>

                    <!-- Action: Reload SLSsteam -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="slssteam api pipe" FontSize="13" Foreground="#666666" />
                        <Button Classes="minimalTextBtn"
                                Content="reload slssteam plugins (reloadlua)"
                                FontSize="16"
                                Foreground="#818CF8"
                                Click="OnReloadSlsClicked" />
                    </StackPanel>

                    <!-- Informational: Library Counts & Paths -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="library summary" FontSize="13" Foreground="#666666" />
                        <TextBlock x:Name="SettingsGameCountsText" Text="loading..." FontSize="14" Foreground="#AAAAAA" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="controller" FontSize="13" Foreground="#666666" />
                        <TextBlock x:Name="SettingsControllerText" Text="no controller detected" FontSize="14" Foreground="#AAAAAA" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
